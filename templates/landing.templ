package templates

// import "fmt"
// import "strings"



templ HomeContent(userName string) {
	<div class="flex flex-col h-full w-full p-20 justify-center">
        <div id="content" class="flex flex-col border min-h-50">
            <div class="flex-start border"> 
                <p>A cool name goes here</p>
                <p>Welcome, { userName }</p>
            </div>
            <div class="flex flex-row flex-grow justify-evenly items-stretch border">
                <div class="w-50 flex-start"> Left</div>
                <div> Right</div>
            </div>
         </div>
    </div>
}
