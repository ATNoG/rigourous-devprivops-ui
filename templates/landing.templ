package templates

// import "fmt"
// import "strings"



templ HomeContent(userName string) {
	<div class="flex flex-col h-full w-full p-20 justify-center">
        <div id="content" class="flex flex-col border min-h-full h-full">
            <div class="flex-start border pb-10"> 
                <p>A cool name goes here</p>
                <p>Welcome, { userName }.</p>
            </div>
            <div class="flex flex-row justify-stretch items-stretch border grow">
                <div class="w-50 grow flex-col flex content-evenly"> 
                    Left
                    <span class="home-link"><a href="#">Link</a></span>
                    <span class="home-link"><a href="#">Link</a></span>
                    <span class="home-link"><a href="#">Link</a></span>
                    <span class="home-link"><a href="#">Link</a></span>
                    <span class="home-link"><a href="#">Link</a></span>

                </div>
                <div class="grow flex-col flex content-evenly"> 
                    Right
                    <span class="home-link"><a href="#">Link</a></span>
                    <span class="home-link"><a href="#">Link</a></span>
                    <span class="home-link"><a href="#">Link</a></span>
                    <span class="home-link"><a href="#">Link</a></span>
                    <span class="home-link"><a href="#">Link</a></span>
                </div>
            </div>
         </div>
    </div>
}
