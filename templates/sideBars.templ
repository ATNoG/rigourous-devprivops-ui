package templates

import "fmt"
import "strings"

type SideBarListElement struct {
	Text string
	Link string
}

type InputType string

const (
	TEXT     InputType = "text"
	RADIO              = "radio"
	CHECKBOX           = "checkbox"
	SUBMIT             = "submit"
	BUTTON             = "button"
)

func (input InputType) String() string {
	switch input {
	case TEXT:
		return "text"
	case RADIO:
		return "radio"
	case CHECKBOX:
		return "checkbox"
	case SUBMIT:
		return "submit"
	case BUTTON:
		return "button"
	}

	return ""
}

type SideBarFormElement struct {
	Type    InputType // The input type
	Id      string    // The HTML id of the field
	Label   string    // The label text
	Default string    // The default value of the field
}

templ SideBarList(elements []SideBarListElement) {
	<ul>
		for _, e := range elements {
			<li><a href={ templ.SafeURL(e.Link) }>{ e.Text }</a></li>
		}
	</ul>
}

templ SideBarForm(endpoint string, elements ...SideBarFormElement) {
	<form action={ templ.SafeURL(endpoint) }>
		<ul>
			for _, e := range elements {
				<li class="grid grid-cols-2 mb-2">
					<label for={ e.Id }>{ e.Label }</label>
					// <input class="text-slate-400" id={ e.Id } type={ e.Type.String() } name={ e.Id } value={ e.Default }/>
					<input id={ e.Id } type={ e.Type.String() } name={ e.Id } value={ e.Default }/>
				</li>
			}
		</ul>
		<input class="mt-10" type="submit" value="Submit"/>
	</form>
}

templ FileList(baseURL string, baseDir string, files []SideBarListElement) {
	/*
	<ul>
		<div>
			for _, e := range files {
				<li><a href={ templ.SafeURL(e.Link) }>{ e.Text }</a></li>
			}
			<li><a href={ templ.SafeURL(createFileEndpoint) }>New File</a></li>
	</ul>
	*/
	// @FileListScript()
	
	<div class="flex flex-col justify-between min-w-min w-full h-full">
		<div id="fileList" class="w-full divide-y divide-gray-200">
			for _, e := range files {
				 {{ 
					filename := e.Text
					if strings.Contains(e.Text,"/") {
						filename = strings.Split(e.Text, "/")[1]
					} 
				}}
				<li class="flex flex-row items-center justify-between hover:bg-gray-200 m-1 ">
					<span class="h-full w-full "><a href={ templ.SafeURL(e.Link) } class="h-full w-full inline-block pt-3 pb-3 pr-auto">{ e.Text }</a> </span>
					
					<button
						class="text-slate-400 p-1 hover:text-red-500 hover:border-red-500 hover:bg-red-100 "
						onclick={ templ.ComponentScript{							
						Call: fmt.Sprintf("deleteFile(this, '%s/%s')", baseDir, filename ),
					} }
					>Delete</button>
				</li>
			}
		</div>
		<div class="mt-10 new-file p-5 rounded border border-opacity-80">
			<div class="pb-2">
			if baseDir[len(baseDir)-1] == 's' {
				<span>{ "Create a new "+ baseDir[:len(baseDir)-1] +":" }</span>
			} else {
				<span>{ "Create a new "+ baseDir +":" }</span>
			}
			</div>
			<div class="flex flex-row flex-no-wrap">
				<input type="text" id="newFileName" placeholder="New file name" class="p-2 bg-stone-300	text-black flex-grow-3 mr-1 hover:ring-1"/>
				<button
					onclick={ templ.ComponentScript{
					Call: fmt.Sprintf("addFile('%s', '%s')", baseURL, baseDir),
				} }
					class="text-slate-400 p-1 hover:text-green-500 hover:border-green-500 hover:bg-green-100"
				>Create</button>
			</div>
		</div>
	</div>
	@FileScript()
}

templ RegulationList(baseDir string, files []SideBarListElement) {
	<ul id="fileList">
		for _, e := range files {
			<li class="grid grid-cols-2 mb-2">
				<span><a href={ templ.SafeURL(e.Link) }>{ e.Text }</a></span>
				<button
					class="text-slate-400"
					onclick={ templ.ComponentScript{
					Call: fmt.Sprintf("deleteFile(this, '%s')", e.Link),
				} }
				>Delete</button>
			</li>
		}
	</ul>
	<div class="mt-5 new-file">
		<input type="text" id="newFileName" placeholder="New regulation name"/>
		<button
			onclick={ templ.ComponentScript{
			Call: fmt.Sprintf("addRegulation('%s')", baseDir),
		} }
		>Add</button>
	</div>
	@FileScript()
}

templ TestList(baseDir string, files []SideBarListElement) {
	<ul id="fileList">
		for _, e := range files {
			<li class="grid grid-cols-2 mb-2">
				<span><a href={ templ.SafeURL(e.Link) }>{ e.Text }</a></span>
				<button
					class="text-slate-400"
					onclick={ templ.ComponentScript{
					Call: fmt.Sprintf("deleteFile(this, '%s')", e.Link),
				} }
				>Delete</button>
			</li>
		}
	</ul>
	<div class="mt-5 new-file">
		<input type="text" id="newFileName" placeholder="New test name"/>
		<button
			onclick={ templ.ComponentScript{
			Call: fmt.Sprintf("addTest('%s')", baseDir),
		} }
		>Add</button>
	</div>
	@FileScript()
}

templ FileScript() {
	<script>
	async function addFile(baseURL, baseDir) {
		const fileNameInput = document.getElementById('newFileName');
		const fileName = fileNameInput.value.trim();
		
		if (fileName === "") {
			alert("File name cannot be empty!");
			return;
		}
		try {
			const response = await fetch(`/create?path=${encodeURIComponent(baseDir + '/' + fileName)}`,
				{method: 'POST'}
			);
			if (!response.ok) {
				throw new Error('Network response was not ok');
			}

			console.log(`'${baseURL}' '${fileName}'`)
			const fileList = document.getElementById('fileList');
			const li = document.createElement('li');
			li.innerHTML = `
				<span><a href='${baseURL}/${fileName}'>${fileName}</a></span>
				<button onclick="deleteFile(this, '${baseDir}/${fileName}')">Delete</button>
			`;
			fileList.appendChild(li);

			fileNameInput.value = '';
		} catch (error) {
			console.error('Error creating file:', error);
			alert('Failed to create file.');
		}
	}

	async function addRegulation(baseDir) {
		const fileNameInput = document.getElementById('newFileName');
		const fileName = fileNameInput.value.trim();

		if (fileName === "") {
			alert("Regulation name cannot be empty!");
			return;
		}

		try {
			const response = await fetch(`/create-regulation?path=${encodeURIComponent(baseDir + '/' + fileName)}`,
				{method: 'POST'}
			);
			if (!response.ok) {
				throw new Error('Network response was not ok');
			}

			const fileList = document.getElementById('fileList');
			const li = document.createElement('li');
			/*
			li.innerHTML = `
				<span>${fileName}</span>
				<button onclick="deleteRegulation(this, '${fileName}')">Delete</button>
			`;
			*/
			li.innerHTML = `
				<span><a href='/regulations/${fileName}'>${fileName}</a></span>
				<button class="text-slate-400" onclick="deleteFile(this, '${baseDir}/${fileName}')">Delete</button>
			`;
			li.classList.add("grid", "grid-cols-2", "mb-2")
			fileList.appendChild(li);

			fileNameInput.value = '';
		} catch (error) {
			console.error('Error creating file:', error);
			alert('Failed to create file.');
		}
	}

	async function addTest(baseDir) {
		const fileNameInput = document.getElementById('newFileName');
		const fileName = fileNameInput.value.trim();

		if (fileName === "") {
			alert("Test name cannot be empty!");
			return;
		}

		try {
			const response = await fetch(`/create-regulation?path=${encodeURIComponent(baseDir + '/' + fileName)}`,
				{method: 'POST'}
			);
			if (!response.ok) {
				throw new Error('Network response was not ok');
			}

			const fileList = document.getElementById('fileList');
			const li = document.createElement('li');
			/*
			li.innerHTML = `
				<span>${fileName}</span>
				<button onclick="deleteRegulation(this, '${fileName}')">Delete</button>
			`;
			*/
			li.innerHTML = `
				<span><a href='/regulations/${fileName}'>${fileName}</a></span>
				<button class="text-slate-400" onclick="deleteFile(this, '${baseDir}/${fileName}')">Delete</button>
			`;
			li.classList.add("grid", "grid-cols-2", "mb-2")
			fileList.appendChild(li);

			fileNameInput.value = '';
		} catch (error) {
			console.error('Error creating file:', error);
			alert('Failed to create file.');
		}
	}

	async function deleteFile(button, fileName) {
		try {
			const response = await fetch(`/delete?path=${encodeURIComponent(fileName)}`,
				{method: 'POST'}
			);
			if (!response.ok) {
				throw new Error('Network response was not ok');
			}

			const li = button.parentElement;
			li.remove();
		} catch (error) {
			console.error('Error deleting file:', error);
			alert('Failed to delete file.');
		}
	}
	
	async function deleteRegulation(button, fileName) {
		try {
			const response = await fetch(`/delete-regulation?path=${encodeURIComponent(fileName)}`,
				{method: 'POST'}
			);
			if (!response.ok) {
				throw new Error('Network response was not ok');
			}

			const li = button.parentElement;
			li.remove();
		} catch (error) {
			console.error('Error deleting file:', error);
			alert('Failed to delete file.');
		}
	}
	</script>
}

templ VerticalList(elements ...func() templ.Component) {
	for _, e := range elements {
		@e()
		<br/>
	}
}


templ FileControls(){
	<div class="flex-item mt-5 p-3 rounded border border-opacity-80 divide-y divide-gray-400 w-full">
		<span class="text-gray-900 font-bold text-lg ">Editor Controls</span>
		
		<label class="inline-flex items-center cursor-pointer pt-3 w-full">
		  <input id="toggleView" type="checkbox" value="" class="sr-only peer">
		  <div class=" !outline-none !ring-0 !border-transparent !focus:border-transparent !focus:ring-0 relative w-11 h-6 bg-gray-200 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-blue-300 dark:peer-focus:ring-blue-800 rounded-full peer dark:bg-gray-700 peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all dark:border-gray-600 peer-checked:bg-blue-600"></div>
		  <span class="font-medium text-gray-900 pl-4">Visual Editor</span>
		</label>


		<!--<div class="flex flex-row justify-between"><p>Current View:</p> <button id="toggleView" class="flex-item">Toggle Visual Editor</button></div> -->
	</div>
}

templ ReasonerMetadata() {
	<div class="flex flex-col min-h-full w-full h-full ">
		@FileControls()
	</div>
}

templ DescriptionMetadata(endpoint string, currentURI string, extendedCurrentURI string, uriList []string) {
	<div class="flex flex-col min-h-full w-full h-full ">
		@FileControls()
		<div class="flex-item mt-5 p-3 rounded border border-opacity-80  w-full">
			<span class="text-gray-900 font-bold text-lg border-bottom border-gray-400 w-full">Edit Current URI</span>
			<hr/>

			<div class="pt-5  w-full">
				<form class="mb-5 flex flex-row justify-between" id="form1" action={ templ.SafeURL(endpoint) }>
					<div class=" flex flex-col">
						<label class="mr-5 pb-1 " for="uri">Select URI</label>
						<select name="uri" id="uri" class="p-2 cursor-pointer">
							for _, s := range uriList {
								if s != currentURI {
									<option value={ s }>{ s }</option>
								} else {
									<option value={ s } selected>{ s }</option>
								}
							}
						</select>
					</div>
					<input id="1" type="submit" value="Apply Change" class="hover:text-green-500 hover:border-green-500 hover:bg-green-100 cursor-pointer"/>
				</form>
			</div>
			<hr/>

			<div class="pt-10 border-bottom border-gray-400 w-full flex-col">
				<span class="text-gray-900 font-bold text-lg text-slate-400 ">Create a New URI</span>
				<hr/>

				<form id="form2" action={ templ.SafeURL(endpoint) }class="pt-5">
					<label for="abreviation">Set Abbreviation</label>
					<br/>
					// <input class="text-slate-400" id="abreviation" type="text" name="abreviation" value={ currentURI }/>
					<input class="p-2 bg-stone-300	text-black flex-grow-3 mr-1 hover:ring-1" id="abreviation" type="text" name="abreviation" value={ currentURI }/>
					<br class="mb-5"/>
					<label for="new-uri">Set New URI</label>
					<br/>
					// <input class="text-slate-400" id="new-uri" type="text" name="new-uri" value={ extendedCurrentURI }/>
					<input class="p-2 bg-stone-300	text-black flex-grow-3 mr-1 hover:ring-1" id="new-uri" type="text" name="new-uri" value={ extendedCurrentURI }/>
					<br class="mb-5"/>
					<input id="2" class="hover:text-green-500 hover:border-green-500 hover:bg-green-100 cursor-pointer" type="submit" value="Create & Assign URI"/>
				</form>
			</div>
		</div>
	</div>

}

templ ConflictList(files []SideBarListElement) {
	<ul id="conflictList">
		if len(files) > 0 {
			for _, e := range files {
				<li>
					<span><a href={ templ.SafeURL(e.Link) }>{ e.Text }</a> </span>
				</li>
			}
		} else {
			<p>There are no conflicts </p>
		}
	</ul>
}

templ ConflictSideBar() {
	<ul>
		// <li><button id="pull-btn" type="button">Pull</button></li>
		<li><button id="push-btn" type="button">Push</button></li>
	</ul>
	<script>
		/*
		document.getElementById("pull-btn").addEventListener('click', function() {
		})
		*/
		
		document.getElementById("push-btn").addEventListener('click', function() {
			fetch("/push", {
				method: 'POST',
				headers: {
					'Content-Type': 'application/json'
				},
				body: {}
			})
			.then(response => response.json())
			.then(data => {
				console.log('Success:', data);
			})
			.catch((error) => {
				console.error('Error:', error);
			});
		})
	</script>
}
